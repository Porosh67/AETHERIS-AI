# AETHERIS AI — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ── watsonx.ai inference (optional — mock fallback used if absent) ──
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Evidence signing ──
# 32+ character random hex string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EVIDENCE_SIGNING_KEY=change-me-generate-a-real-key-before-use

# ── CORS (frontend URL) ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App settings ──
AETHERIS_ENV=development
DATABASE_URL=sqlite:///./aetheris.db
MAX_REPAIR_ATTEMPTS=3
INFERENCE_TIMEOUT_SECONDS=15
